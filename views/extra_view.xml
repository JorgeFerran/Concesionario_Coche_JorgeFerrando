<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="extra_view_list" model="ir.ui.view">
    <field name="name">concesionario.extra.list</field>
    <field name="model">concesionario.extra</field>
    <field name="arch" type="xml">
      <list string="Lista de extras">
        <field name="name"/>
        <field name="codigo"/>
        <field name="categoria"/>
        <field name="precio"/>
      </list>
    </field>
  </record>

  <record id="extra_view_form" model="ir.ui.view">
    <field name="name">concesionario.extra.form</field>
    <field name="model">concesionario.extra</field>
    <field name="arch" type="xml">
      <form string="Ficha del extra">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="codigo"/>
              <field name="categoria"/>
              <field name="precio"/>
            </group>
          </group>
          <group string="Descripción">
            <field name="descripcion" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="extra_view_search" model="ir.ui.view">
    <field name="name">concesionario.extra.search</field>
    <field name="model">concesionario.extra</field>
    <field name="arch" type="xml">
      <search string="Buscar extras">
        <field name="name"/>
        <field name="codigo"/>
        <filter name="filtro_seguridad" string="Seguridad" domain="[('categoria', '=', 'seguridad')]"/>
        <filter name="filtro_confort" string="Confort" domain="[('categoria', '=', 'confort')]"/>
        <filter name="filtro_tecnologia" string="Tecnología" domain="[('categoria', '=', 'tecnologia')]"/>
        <filter name="agrupar_categoria" string="Categoría" context="{'group_by': 'categoria'}"/>
      </search>
    </field>
  </record>

  <record id="extra_action" model="ir.actions.act_window">
    <field name="name">Extras</field>
    <field name="res_model">concesionario.extra</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
